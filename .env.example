# ==========================================
# CẤU HÌNH CRYPTO FUTURES QUANT BOT (H4/M15)
# ==========================================

# 1. Quản lý Vốn & Rủi ro (Fixed 1R Risk Model)
RISK_USD_PER_TRADE=10.0           # 1R = Số tiền chấp nhận mất tối đa mỗi lệnh (USDT)
LEVERAGE=10                      # Đòn bẩy tài khoản (Isolated 10X)
FEE_RATE=0.0008                  # Phí Futures Taker khứ hồi (0.08% = 0.04% x 2)
MIN_RR_RATIO=2.0                 # Tỷ lệ R:R tối thiểu bắt buộc để vào lệnh (>= 2.0)
BE_TRIGGER_R=1.5                 # Mốc lợi nhuận kích hoạt kéo SL (+1.5R)
LOCK_PROFIT_R=1.0                # Mức kéo SL lên để khóa lợi nhuận (+1.0R) gồng tiếp tới 2R
TIME_STOP_BARS=16                # Số nến M15 tối đa (4 tiếng) nếu PnL đi ngang +-0.3R thì đóng hòa vốn
MIN_COIN_PRICE=1.0                 # Giá tối thiểu của coin (USDT) để xét giao dịch (mặc định >= 1.0$, chặn coin 0.xx)

# 2. Chế độ Quét Thị trường (Scanner Configuration)
# Chế độ quét: WATCHLIST (Khóa chặt Danh mục Coin Lớn: BTC, ETH, SOL, LINK, NEAR, HYPE) hoặc DYNAMIC_TOP
SCAN_MODE=WATCHLIST              # 'WATCHLIST' | 'DYNAMIC_TOP'
TOP_COINS_LIMIT=6                # Số lượng coin lớn quét
WATCHLIST=BTC-USDT,ETH-USDT,SOL-USDT,LINK-USDT,NEAR-USDT,HYPE-USDT
POLL_INTERVAL_SEC=60             # Chu kỳ quét lại thị trường (giây)

# 3. Cấu hình OKX API (Mặc định dùng Public API miễn phí)
OKX_BASE_URL=https://www.okx.com

# 4. Cấu hình Telegram Alerts
# Lấy Bot Token từ @BotFather, Chat ID từ @userinfobot. Nếu để trống, bot sẽ in log đẹp ra terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

